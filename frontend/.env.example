# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# Base URL of the backend API. The app appends "/api" to this.
REACT_APP_BACKEND_URL=http://localhost:8001

# Google Sign-In client id (same value as backend GOOGLE_CLIENT_ID).
# Leave empty to use the passwordless email dev-login form for local testing.
# REACT_APP_GOOGLE_CLIENT_ID=

# The site's own public URL (no trailing slash) -- only used by
# `yarn sitemap` (scripts/generate-sitemap.js) to build absolute URLs in
# sitemap.xml. Not read by the app itself (canonical/OG tags use the
# browser's real window.location instead), so it's fine to leave unset for
# local dev; set it to the real production domain before running `yarn
# sitemap` for a deploy.
# SITE_URL=https://yourdomain.com
