# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# --- Database (required) ---
# A plain postgresql:// URL works as-is (app/config.py upgrades it to the
# asyncpg driver scheme automatically) -- from Neon, Render, pgAdmin, etc.
DATABASE_URL=postgresql://rari:rari_dev_pw@localhost:5433/rari_local

# --- Auth (required) ---
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@rari.com
ADMIN_PASSWORD=change-me

# --- CORS (required) ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# --- Optional ---
APP_NAME=rariethnic

# Google Sign-In. When empty, the passwordless dev-login auto-enables.
# GOOGLE_CLIENT_ID=

# Force dev-login on/off regardless of GOOGLE_CLIENT_ID (true/false).
# Set to false to be safe on any public deployment.
# ALLOW_DEV_LOGIN=

# Emergent object storage for image uploads (only on the Emergent platform).
# EMERGENT_LLM_KEY=

# A Razorpay order left pending_payment (abandoned checkout) past this many
# minutes is auto-cancelled and its reserved stock released.
# PENDING_PAYMENT_TIMEOUT_MINUTES=30
# PENDING_PAYMENT_SWEEP_INTERVAL_SECONDS=300
