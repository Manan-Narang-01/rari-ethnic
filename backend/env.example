# Copy to .env and fill in real values. Never commit the real .env (it's gitignored).

MONGO_URL=mongodb://localhost:27017
DB_NAME=rariethnic
APP_NAME=rariethnic
CORS_ORIGINS=http://localhost:3000

# Long, random, unique per environment. Rotate on suspected compromise --
# rotating this invalidates every issued access/refresh token immediately.
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Seeded into the users collection at startup if set. Leave unset to skip seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me

# Emergent-hosted object storage (see app/utils/storage.py). Not needed once
# migrated to S3-compatible storage.
EMERGENT_LLM_KEY=

BACKEND_PUBLIC_URL=

# Customer-facing Google Sign-In (see app/core/google_auth.py). Must match the
# frontend's REACT_APP_GOOGLE_CLIENT_ID. Leave unset to fall back to dev login.
GOOGLE_CLIENT_ID=

# Passwordless customer login for local/test use. Auto-enabled while
# GOOGLE_CLIENT_ID is unset; set true to force it on even once Google is configured.
ALLOW_DEV_LOGIN=

# Symmetric key (Fernet) used to encrypt payment/shipping provider credentials
# at rest in the integrations collection. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes previously stored credentials undecryptable.
CREDENTIALS_ENCRYPTION_KEY=
